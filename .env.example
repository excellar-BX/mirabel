# Copy to .env for local development. In production, set these in your host's dashboard.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school-id-system

# Password for the admin pages (dashboard, register, people, logs)
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign admin session cookies (at least 32 random characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long an admin stays logged in (hours)
SESSION_TTL_HOURS=12

# School timezone, used for "today" (visitor dates, daily counts)
APP_TIMEZONE=Africa/Lagos

# Port for the standalone server (ignored on Vercel)
PORT=5000
